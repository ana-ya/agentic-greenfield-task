{
  "$schema": "./node_modules/fallow/schema.json",
  "ignorePatterns": [
    "docs/design-system/**"
  ],
  "ignoreDependencies": [
    "@tailwindcss/turbopack"
  ],
  "ignoreExports": [
    { "file": "components/design-system/index.ts", "exports": ["*"] },
    // Design-system API kept for an upcoming feature: MAX_PINNED_CITIES for weekend compare (M4).
    // Remove the entry once it is used.
    { "file": "components/design-system/CompareTable.tsx", "exports": ["MAX_PINNED_CITIES"] }
  ]
}
