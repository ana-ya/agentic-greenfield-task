    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fallow": "3.47.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
